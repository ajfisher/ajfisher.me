---
import ListItem from './ListItem.astro';
import { mergeEntryData } from '../lib/content-utils.mjs';

const {
  items,
  compact = false,
} = Astro.props;

const compactStyle = compact ? 'compact' : '';

const resolvedItems = items.map(mergeEntryData);

---
<ul class={`listitems ${compactStyle}`}>
  {resolvedItems.map((item) => (
    <ListItem {...item} compact={compact} />
  ))}
</ul>

<style>
  ul.listitems {
    list-style: none;
    padding: 0;
    margin: 0 var(--gutter) !important;

    @media only screen and (min-width: 601px) {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--gutter);
      grid-auto-rows: auto;
      align-items: start;
    }
  }
</style>
